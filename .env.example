# ---- Supabase (required for CMS, uploads, submissions, admin) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only – never expose
# Comma-separated list of emails allowed into /admin
ADMIN_EMAILS=you@ignixales.com

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Email (Resend). Without a key, emails are logged to the server console ----
RESEND_API_KEY=
EMAIL_FROM="Ignixales <hello@ignixales.com>"
TEAM_NOTIFY_EMAIL=hello@ignixales.com

# ---- Analytics (loaded only after cookie consent) ----
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---- Optional: Cloudflare Turnstile spam protection ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
